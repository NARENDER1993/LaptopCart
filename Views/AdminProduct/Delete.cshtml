@model Product
<div class="card border-1">
    <div class="card-header ml-0 text-white" style="background-color:red">
        <h1 class="p-2 text-center">Delete Product</h1>
    </div>
    <div class="card-body mt-3">
        <h5 class="text-danger mb-4 text-center"> Are you sure  you want to delete this?</h5>
        <div class="row mb-3">
            <div class="col-md-4 text-center">
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" alt="ProductImage" width="100" height="100" class="img-thumbanil" />

                }
                else
                {
                    <span class="text-muted">No Image</span>
                }
            </div>
            <div class="col-md-8">
                <div class="form-floating mb-3">
                    <input asp-for="Name" class="form-control" disabled />
                    <label asp-for="Name" class="ms-2 text-muted"></label>
                </div>
                <div class="form-floating mb-3">
                    <textarea asp-for="Description" class="form-control" /></textarea>
                    <label asp-for="Description" class="ms-2 text-muted"></label>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Price" class="form-control" disabled />
                    <label asp-for="Price" class="ms-2 text-muted"></label>
                </div>

            </div>
            <div>
                <form asp-action="DeleteConfimed" method="Post">
                   <input type="hidden" asp-for="Id" /> 
                    <div class="row justify-content-between">
                        <div class="col-3">
                            <a asp-action="Index" class="btn btn-secondary w-100">Back</a>
                        </div>
                        <div class="col-6">
                            <button type="submit" class="btn text-white" style="background-color:red">Yes, Delete</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>
